#include <memory>
#include <utility>

#include "vision/DragonLimelight.h"
#include "vision/DragonQuest.h"
#include "vision/DragonVision.h"
#include "vision/definitions/{{ class_name }}.h"
#include "wpi/units/angle.hpp"
#include "wpi/units/length.hpp"

void {{ class_name }}::BuildCameraConfig()
{
    auto vision = DragonVision::GetDragonVision();
    if (vision == nullptr)
    {
        return;
    }
{% for camera in cameras %}
{% if camera.type == "Limelight" %}
    auto {{ camera.name | camel }} = std::make_unique<DragonLimelight>(
        "{{ camera.name }}",
        DRAGON_LIMELIGHT_CAMERA_IDENTIFIER::{{ camera.identifier }},
        DRAGON_LIMELIGHT_CAMERA_TYPE::{{ camera.camera_type }}, 
        DRAGON_LIMELIGHT_CAMERA_USAGE::{{ camera.usage }},
        {{ camera.x | float }}{{ camera.units.x | short_unit }}, // LL Forward ({{ camera.inch_offsets.x | float }} in)  /// <I> x offset of cam from robot center (forward relative to robot)
        {{ camera.y | float }}{{ camera.units.y | short_unit }}, // LL Right ({{ camera.inch_offsets.y | float }} in) /// <I> y offset of cam from robot center (right relative to robot)
        {{ camera.z | float }}{{ camera.units.z | short_unit }}, // LL Up ({{ camera.inch_offsets.z | float }} in) /// <I> z offset of cam from robot center (up relative to robot)
        {{ (camera.pitch) | float }}{{ camera.units.pitch | short_unit }}, // LL Pitch,  /// <I> - Pitch of Camera
        {{ camera.yaw | float }}{{ camera.units.yaw | short_unit }}, // LL Yaw,        /// <I> - Yaw of Camera
        {{ camera.roll | float }}{{ camera.units.roll | short_unit }}, // LL Roll,     /// <I> - Roll of Camera
        DRAGON_LIMELIGHT_PIPELINE::{{ camera.pipeline }}, /// <I> enum for starting pipeline 
        DRAGON_LIMELIGHT_LED_MODE::{{ camera.led_mode }}); // DRAGON_LIMELIGHT_LED_MODE ledMode,
    vision->AddLimelight(std::move( {{ camera.name | camel }}), DRAGON_LIMELIGHT_CAMERA_USAGE::{{ camera.usage }});
{% else %}
    auto {{ camera.name }} = std::make_unique<DragonQuest>(
        {{ camera.x | float }}{{ camera.units.x | short_unit }},  // <I> x offset of Quest from robot center (forward relative to robot)
        {{ camera.y | float }}{{ camera.units.y | short_unit }},  // <I> y offset of Quest from robot center (left relative to robot)
        {{ camera.z | float }}{{ camera.units.z | short_unit }},  // <I> z offset of Quest from robot center (up relative to robot)
        {{ camera.pitch | float }}{{ camera.units.pitch | short_unit }}, // <I> - Pitch of Quest
        {{ camera.yaw | float }}{{ camera.units.yaw | short_unit }}, // <I> - Yaw of Quest
        {{ camera.roll | float }}{{ camera.units.roll | short_unit }});  // <I> - Roll of Quest
    vision->AddQuest(std::move( {{ camera.name | camel }}));
{% endif %}
{% endfor %}
}
